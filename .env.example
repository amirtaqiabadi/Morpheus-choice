# Pooled Neon connection string for the Vercel project.
# The real value lives in Vercel environment variables and is not committed.
DATABASE_URL=

# Bot token from @BotFather. Validates Mini App initData and signs sessions.
TELEGRAM_BOT_TOKEN=

# Bot username without @. Invite links are https://t.me/<username>?startapp=<code>
TELEGRAM_BOT_USERNAME=

# Optional short name when the Mini App is not the bot's main app.
# Link becomes https://t.me/<username>/<short_name>?startapp=<code>
TELEGRAM_APP_SHORT_NAME=

# OAuth client id and secret from BotFather → Login Widget.
# Allowed URLs must include the site origin and /api/auth/callback
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
